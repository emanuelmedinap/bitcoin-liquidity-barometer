# Only needed to RE-BUILD the panel from source (SEC EDGAR + FRED into BigQuery).
# The tests, the figure and the report need none of this: they read the committed
# 72-quarter snapshot in analysis/. Copy to .env and fill in. .env is gitignored.

GCP_PROJECT=YOUR_GCP_PROJECT              # BigQuery project holding banks_raw / banks_clean / banks_marts
FRED_API_KEY=<your-fred-api-key>          # free, from fred.stlouisfed.org
SEC_USER_AGENT="Your Name your@email.com" # SEC fair-access policy requires a descriptive User-Agent
